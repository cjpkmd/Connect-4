@page "/"
@using System.ComponentModel
@using System.Windows.Input
@using CommunityToolkit.Mvvm.Input
@using Connect4.App.Models
@implements IDisposable
@inject MainViewModel Vm
@inject BrowserDialogService Dialogs
@inject AppearanceStore AppearanceStore
@inject IJSRuntime JS

@* Not Vm.Title ("Connect 4 – Untitled"): the tab title is also the bookmark name. *@
<PageTitle>Connect 4. A four in a row computer game.</PageTitle>

<div class="app" inert="@(Dialogs.Current is not null)">
    <nav class="menubar" aria-label="Menu">
        @foreach (MenuDefinition menu in _menus)
        {
            <div class="menu">
                <button class="menu-title @(menu == _openMenu ? "open" : null)" aria-haspopup="menu" aria-expanded="@(menu == _openMenu ? "true" : "false")"
                        @onclick="() => ToggleMenu(menu)" @onmouseenter="() => HoverMenu(menu)">@menu.Title</button>
                @if (menu == _openMenu)
                {
                    <div class="menu-items" role="menu">
                        @foreach (MenuEntry entry in menu.Entries)
                        {
                            bool? isChecked = entry.IsChecked?.Invoke();
                            string role = isChecked is null ? "menuitem" : entry.Radio ? "menuitemradio" : "menuitemcheckbox";
                            <button role="@role" aria-checked="@(isChecked is { } c ? (c ? "true" : "false") : null)"
                                    class="@(entry.SeparatorBefore ? "separator-before" : null)"
                                    disabled="@(!entry.Command.CanExecute(null))" @onclick="() => RunAsync(entry.Command)">
                                <span class="check">@(isChecked == true ? (entry.Radio ? "●" : "✓") : "")</span>
                                <span>@entry.Text</span>
                                <span class="shortcut">@entry.Shortcut</span>
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </nav>
    @if (_openMenu is not null)
    {
        <div class="menu-backdrop" @onclick="() => _openMenu = null"></div>
    }

    <main class="content">
        <div class="board-area">
            <Board Cells="Vm.Cells" NextDisc="Vm.NextDisc" Appearance="_appearance" OnPlay="Play" />
        </div>

        <div class="side-panels">
            <section class="panel status" role="status" aria-label="Status">
                <h2>Status</h2>
                <p>@Vm.Status</p>
                <p>@Vm.SidesText</p>
                @if (Vm.ClockText.Length > 0)
                {
                    <p>@Vm.ClockText</p>
                }
            </section>

            @if (Vm.IsAnalysisVisible)
            {
                <aside class="panel analysis" aria-label="Analysis">
                    <h2>Analysis</h2>
                    <dl>
                        <dt>Move:</dt><dd>@Vm.Analysis.Move</dd>
                        <dt>Depth:</dt><dd>@Vm.Analysis.Depth</dd>
                        <dt>Value:</dt><dd>@Vm.Analysis.Value</dd>
                        <dt>Best move:</dt><dd>@Vm.Analysis.BestMove</dd>
                        <dt>Line:</dt><dd class="line">@Vm.Analysis.Line</dd>
                        <dt>Nodes:</dt><dd>@Vm.Analysis.Nodes</dd>
                        <dt>Time:</dt><dd>@Vm.Analysis.Time</dd>
                    </dl>
                </aside>
            }
        </div>
    </main>
</div>

@code {
    private MenuDefinition[] _menus = [];
    private ICommand[] _commands = [];
    private MenuDefinition? _openMenu;
    private DotNetObjectReference<Home>? _self;
    private Appearance _appearance = Appearance.Default;
    private bool _renderPending;

    protected override void OnInitialized()
    {
        _appearance = AppearanceStore.Load();

        _menus =
        [
            new("File",
            [
                new("New Game", Vm.NewGameCommand),
                new("Open...", Vm.OpenCommand, "Ctrl+O"),
                new("Save", Vm.SaveCommand, "Ctrl+S"),
                new("Save As...", Vm.SaveAsCommand),
            ]),
            new("Game",
            [
                ModeEntry("Human vs Computer", GameMode.HumanVsComputer),
                ModeEntry("Human vs Human", GameMode.HumanVsHuman),
                new("Switch Sides", Vm.SwitchSidesCommand, SeparatorBefore: true),
                new("Move Now", Vm.MoveNowCommand, "Ctrl+M"),
                new("Settings...", Vm.EditSettingsCommand, SeparatorBefore: true),
            ]),
            new("Moves",
            [
                new("Back", Vm.UndoCommand, "Ctrl+Z"),
                new("Forward", Vm.RedoCommand, "Ctrl+Y"),
            ]),
            new("View",
            [
                new("Analysis", Vm.ToggleAnalysisCommand, "Ctrl+A", () => Vm.IsAnalysisVisible),
                new("Sound", Vm.ToggleSoundCommand, IsChecked: () => Vm.IsSoundOn),
                BoardEntry("Blue Board", BoardStyle.Blue, separatorBefore: true),
                BoardEntry("Golden Oak Board", BoardStyle.GoldenOak),
                BoardEntry("Reddish Wood Board", BoardStyle.ReddishWood),
                new("3D Discs", ChangeAppearance(a => a with { Discs3D = !a.Discs3D }), IsChecked: () => _appearance.Discs3D, SeparatorBefore: true),
                new("Animate Drops", ChangeAppearance(a => a with { AnimateDrops = !a.AnimateDrops }), IsChecked: () => _appearance.AnimateDrops),
            ]),
            new("Brain", [new("How Connect 4 Thinks", new RelayCommand(OpenDocs))]),
            new("Help", [new("About Connect 4...", Vm.AboutCommand)]),
        ];
        _commands = _menus.SelectMany(menu => menu.Entries).Select(entry => entry.Command).ToArray();

        Vm.PropertyChanged += OnChanged;
        Vm.Analysis.PropertyChanged += OnChanged;
        Dialogs.Changed += OnDialogChanged;
        foreach (CellViewModel cell in Vm.Cells)
        {
            cell.PropertyChanged += OnChanged;
        }

        foreach (ICommand command in _commands)
        {
            command.CanExecuteChanged += OnChanged;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("connect4.registerShortcuts", _self);
        }
    }

    public void Dispose()
    {
        Vm.PropertyChanged -= OnChanged;
        Vm.Analysis.PropertyChanged -= OnChanged;
        Dialogs.Changed -= OnDialogChanged;
        foreach (CellViewModel cell in Vm.Cells)
        {
            cell.PropertyChanged -= OnChanged;
        }

        foreach (ICommand command in _commands)
        {
            command.CanExecuteChanged -= OnChanged;
        }

        if (_self is not null)
        {
            ((IJSInProcessRuntime)JS).InvokeVoid("connect4.unregisterShortcuts");
            _self.Dispose();
        }
    }

    [JSInvokable]
    public Task OnShortcut(string key) => Dialogs.Current is not null ? Task.CompletedTask : key switch
    {
        "o" => RunAsync(Vm.OpenCommand),
        "s" => RunAsync(Vm.SaveCommand),
        "m" => RunAsync(Vm.MoveNowCommand),
        "z" => RunAsync(Vm.UndoCommand),
        "y" => RunAsync(Vm.RedoCommand),
        "a" => RunAsync(Vm.ToggleAnalysisCommand),
        _ => Task.CompletedTask,
    };

    // Outside UI events Blazor WebAssembly renders at once on StateHasChanged, so without this the board would
    // be drawn once for each cell as the view model updates it.
    private void OnChanged(object? sender, EventArgs e)
    {
        if (_renderPending)
        {
            return;
        }

        _renderPending = true;
        _ = InvokeAsync(async () =>
        {
            await Task.Yield();
            _renderPending = false;
            StateHasChanged();
        });
    }

    private void OnDialogChanged() => InvokeAsync(StateHasChanged);

    private void Play(int column) => Vm.PlayCommand.Execute(column);

    // A new tab, so the game stays open next to the documentation.
    private void OpenDocs() => ((IJSInProcessRuntime)JS).InvokeVoid("open", BrainDocs.PageRoute(""), "_blank", "noopener");

    private MenuEntry ModeEntry(string text, GameMode mode) =>
        new(text, new AsyncRelayCommand(() => Vm.SetModeCommand.ExecuteAsync(mode)), IsChecked: () => Vm.Mode == mode, Radio: true);

    private MenuEntry BoardEntry(string text, BoardStyle board, bool separatorBefore = false) =>
        new(text, ChangeAppearance(a => a with { Board = board }), IsChecked: () => _appearance.Board == board, Radio: true, SeparatorBefore: separatorBefore);

    private RelayCommand ChangeAppearance(Func<Appearance, Appearance> change) => new(() =>
    {
        _appearance = change(_appearance);
        AppearanceStore.Save(_appearance);
    });

    private void ToggleMenu(MenuDefinition menu) => _openMenu = _openMenu == menu ? null : menu;

    private void HoverMenu(MenuDefinition menu)
    {
        if (_openMenu is not null)
        {
            _openMenu = menu;
        }
    }

    private async Task RunAsync(ICommand command)
    {
        _openMenu = null;
        if (!command.CanExecute(null))
        {
            return;
        }

        if (command is IAsyncRelayCommand asyncCommand)
        {
            await asyncCommand.ExecuteAsync(null);
        }
        else
        {
            command.Execute(null);
        }

        StateHasChanged();
    }

    private sealed record MenuDefinition(string Title, MenuEntry[] Entries);

    private sealed record MenuEntry(
        string Text,
        ICommand Command,
        string? Shortcut = null,
        Func<bool>? IsChecked = null,
        bool Radio = false,
        bool SeparatorBefore = false);
}