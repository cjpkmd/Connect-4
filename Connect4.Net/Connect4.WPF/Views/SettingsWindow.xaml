<Window x:Class="Connect4.WPF.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Connect4.App.ViewModels;assembly=Connect4.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Settings" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="90" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="3" Margin="0,0,0,12" Text="How long may the computer think?" />

        <RadioButton Grid.Row="1" Margin="0,4,12,4" VerticalAlignment="Center" GroupName="Mode"
                     Content="Fixed depth" IsChecked="{Binding IsFixedDepth}" />
        <Slider Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Minimum="1" Maximum="{Binding MaxDepth}"
                IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Depth}" IsEnabled="{Binding IsFixedDepth}"
                AutomationProperties.Name="Depth" />
        <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                   Text="{Binding Depth, StringFormat={}{0} plies}" />

        <RadioButton Grid.Row="2" Margin="0,4,12,4" VerticalAlignment="Center" GroupName="Mode"
                     Content="Time per move" IsChecked="{Binding IsTimePerMove}" />
        <Slider Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Minimum="1" Maximum="{Binding MaxSecondsPerMove}"
                IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding SecondsPerMove}" IsEnabled="{Binding IsTimePerMove}"
                AutomationProperties.Name="Seconds per move" />
        <TextBlock Grid.Row="2" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                   Text="{Binding SecondsPerMove, StringFormat={}{0} seconds}" />

        <RadioButton Grid.Row="3" Margin="0,4,12,4" VerticalAlignment="Center" GroupName="Mode"
                     Content="Time per game" IsChecked="{Binding IsTimePerGame}" />
        <Slider Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Minimum="1" Maximum="{Binding MaxMinutesPerGame}"
                IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding MinutesPerGame}" IsEnabled="{Binding IsTimePerGame}"
                AutomationProperties.Name="Minutes per game" />
        <TextBlock Grid.Row="3" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                   Text="{Binding MinutesPerGame, StringFormat={}{0} minutes}" />

        <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Margin="0,16,0,4" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left"
                   Text="With a time limit, try to solve the game exactly when this many cells or fewer are empty (0 = never). With a fixed depth the depth is used." />
        <TextBlock Grid.Row="5" Margin="0,4,12,4" VerticalAlignment="Center" Text="Endgame solver" />
        <Slider Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="{Binding MaxEndgameThreshold}"
                IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding EndgameThreshold}"
                AutomationProperties.Name="Endgame solver threshold" />
        <TextBlock Grid.Row="5" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                   Text="{Binding EndgameThreshold, StringFormat={}{0} cells}" />

        <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="80" Content="OK" IsDefault="True" Click="OnOk" />
            <Button Width="80" Margin="8,0,0,0" Content="Cancel" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
