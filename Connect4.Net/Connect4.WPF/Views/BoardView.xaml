<UserControl x:Class="Connect4.WPF.Views.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:engine="clr-namespace:Connect4.Engine;assembly=Connect4.Engine"
             xmlns:vm="clr-namespace:Connect4.App.ViewModels;assembly=Connect4.App"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignWidth="420" d:DesignHeight="450">
    <UserControl.Resources>
        <SolidColorBrush x:Key="RedDisc" Color="#D32F2F" />
        <SolidColorBrush x:Key="YellowDisc" Color="#FBC02D" />
        <SolidColorBrush x:Key="BoardBrush" Color="#1565C0" />
        <SolidColorBrush x:Key="HoleBrush" Color="#E8EEF6" />

        <Style x:Key="DiscStyle" TargetType="Ellipse">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Stroke" Value="#40000000" />
            <Setter Property="StrokeThickness" Value="2" />
        </Style>

        <!-- A column: the whole column is one button; the top row shows the disc that would be dropped. -->
        <ControlTemplate x:Key="ColumnTemplate" TargetType="Button">
            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Ellipse x:Name="Preview" Margin="6" Opacity="0.8" Visibility="Hidden" />
                <Border x:Name="Highlight" Grid.Row="1" Background="#18FFFFFF" Visibility="Hidden" />
            </Grid>
            <ControlTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding DataContext.NextDisc, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Value="{x:Static engine:Player.Red}" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Preview" Property="Fill" Value="{StaticResource RedDisc}" />
                    <Setter TargetName="Preview" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Highlight" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding DataContext.NextDisc, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Value="{x:Static engine:Player.Yellow}" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Preview" Property="Fill" Value="{StaticResource YellowDisc}" />
                    <Setter TargetName="Preview" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Highlight" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <Viewbox VerticalAlignment="Top">
        <!-- 7 columns of 60; a preview row of 60, 6 rows of 60 and the column numbers. -->
        <Grid Width="420" Height="450">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="360" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <Border Grid.Row="1" Background="{StaticResource BoardBrush}" CornerRadius="8" />

            <ItemsControl x:Name="CellsControl" Grid.Row="1" ItemsSource="{Binding Cells}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="6" Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CellViewModel}">
                        <Grid>
                            <Ellipse Margin="6" Fill="{StaticResource HoleBrush}" />
                            <Ellipse x:Name="Disc" Margin="6" Style="{StaticResource DiscStyle}" />
                            <Ellipse x:Name="Winning" Margin="3" Stroke="White" StrokeThickness="4" Visibility="Collapsed" />
                            <Ellipse x:Name="Last" Width="10" Height="10" Fill="#B0FFFFFF" Visibility="Collapsed" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Disc}" Value="{x:Static engine:Player.Red}">
                                <Setter TargetName="Disc" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Disc" Property="Fill" Value="{StaticResource RedDisc}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Disc}" Value="{x:Static engine:Player.Yellow}">
                                <Setter TargetName="Disc" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Disc" Property="Fill" Value="{StaticResource YellowDisc}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsWinning}" Value="True">
                                <Setter TargetName="Winning" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLastMove}" Value="True">
                                <Setter TargetName="Last" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Clickable columns over the preview row and the board. -->
            <UniformGrid x:Name="ColumnButtons" Grid.RowSpan="2" Rows="1" Columns="7" />

            <UniformGrid Grid.Row="2" Rows="1" Columns="7">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="1" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="2" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="3" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="4" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="5" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="6" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="7" />
            </UniformGrid>
        </Grid>
    </Viewbox>
</UserControl>
