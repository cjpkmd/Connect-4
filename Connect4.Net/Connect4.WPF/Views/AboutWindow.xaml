<Window x:Class="Connect4.WPF.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Connect4.App.Models;assembly=Connect4.App"
        Title="{x:Static models:AboutInfo.Title}" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,16,0">
            <Border CornerRadius="6" ClipToBounds="True" BorderBrush="#CCC" BorderThickness="1">
                <Image Source="/Images/ClausPedersen.jpg" Width="152" Height="152" Stretch="UniformToFill"
                       AutomationProperties.Name="Claus Pedersen" />
            </Border>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#555"
                       Text="{x:Static models:AboutInfo.PictureCaption}" />
        </StackPanel>

        <StackPanel Grid.Column="1">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Static models:AboutInfo.Version}" />
            <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Static models:AboutInfo.Paragraphs}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Button Grid.Row="1" Grid.Column="1" Width="80" Margin="0,16,0,0" HorizontalAlignment="Right"
                Content="OK" IsDefault="True" IsCancel="True" />
    </Grid>
</Window>
